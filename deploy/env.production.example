APP_NAME="Allpro Services"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.allpro.ie
APP_TIMEZONE=Europe/Dublin
APP_LOCALE=en
APP_FAKER_LOCALE=en_IE
APP_FALLBACK_LOCALE=en

# One-time web installer (only needed if you have no SSH). Remove after setup.
SETUP_TOKEN=

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u000000000_allpro
DB_USERNAME=u000000000_allpro
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Outgoing mail.
# allpro.ie mail is on Microsoft 365 (MX allpro-ie.mail.protection.outlook.com), so send
# through a licensed M365 mailbox with SMTP AUTH enabled, or add Hostinger to the SPF record first.
MAIL_MAILER=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=no-reply@allpro.ie
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@allpro.ie
MAIL_FROM_NAME="${APP_NAME}"

# true on the temporary preview domain: banner + noindex. Set false at launch.
ALLPRO_PREVIEW=false
ALLPRO_PUBLIC_EMAIL=helpdesk@allpro.ie
# Who is emailed about new submissions, comma separated. Each area falls back to ALLPRO_NOTIFY_EMAIL.
ALLPRO_NOTIFY_EMAIL=
ALLPRO_NOTIFY_CAREERS=
# HR: the daily PSA licence reminder digest.
ALLPRO_NOTIFY_HR=
ALLPRO_NOTIFY_QUOTES=
ALLPRO_NOTIFY_SERVICEDESK=
ALLPRO_NOTIFY_ENQUIRIES=

# First staff account, created by `php artisan db:seed` (or setup.php). Remove the password after first sign-in.
#ADMIN_NAME="Administrator"
#ADMIN_EMAIL=
#ADMIN_PASSWORD=
